\u7531\u8d77\u59cb\u8282\u70b9\u5230\u7ec8\u7aef\u7ed3\u70b9\uff0c\u524d\u9a71\u4e0e\u540e\u7ee7 \n  2.1\u987a\u5e8f\u5b58\u50a8\uff1a\u5360\u7528\u4e00\u7247\u8fde\u7eed\u7684\u5b58\u50a8\u7a7a\u95f4\n  \u50a8\u5b58\u7a7a\u95f4\u4e0d\u7075\u6d3b\uff0c\u7a7a\u95f4\u590d\u6742\u5ea6\u9ad8,\u63d2\u5165\u5220\u9664\u9ebb\u70e6\n  \u4f8b\u5982\uff1a\u591a\u9879\u5f0f\u7684\u7cfb\u6570\u4e0e\u6307\u6570\u5b58\u653e\uff1a\n```  \ntypedef struct{\n       float p;  //\u4e5f\u53ef\u4ee5typedef char/~ elemtype;\u65b9\u4fbf\u540e\u7eed\u7ba1\u7406\u7ef4\u62a4\n       int e;\n  }poly;\n  typedef struct{\n       poly *elem;  //poly\u7c7b\u578b\u7684\u6570\u7ec4\uff08\u9700\u7533\u8bf7\u5185\u5b58\uff0c\u6ce8\u610f\u6307\u9488\u7684\u7c7b\u578b\uff09 or elemtype elem[max];(#define max n) or new elemtype(n);\n       int length;\n  }list;\n```\n\u901a\u5e38\u9884\u5b9a\u4e00\u4e9b\u5e38\u91cf\uff1a\u5bf91\u95190 overflow-2\uff1bint->Status(\u5224\u65ad\u8fd4\u56de\u7c7b\u578b)\n2.2\u529f\u80fd\u5b9e\u73b0\uff1a\n1.\u521d\u59cb\u5316:\n```\nStatus inilist (list & L){\n\tL.elem=new elemtype(max);\n\tIf(!L.elem)  //\u67e5\u770b\u5185\u5b58\u5730\u5740\n\t\tExit(overflow);  //\u9632\u6b62\u5206\u914d\u5931\u8d25\n\tL.length=0;\n\tReturn OK;\n}\n```\n2.\u5220\u9664\uff1a\n```\nVoid destroylist(list &L){\n\tif(L.elem)\n\t\tDelete L.elem;\n}\n```\n3.\u53d6\u503c\uff1a\n```\nStatus getelem(list L,int i,int &e){\n\t//\u786e\u5b9ai\u503c\n\tIf(i<1||i>L.length)\n\t\tReturn 0;\n\te=L.elem[i-1];\n\n\treturn 1;\n}\n```\n\n4.\u67e5\u627e\uff1a\n\n```\n\tint findelem(list L,int e){\n\t\tint i=0;\n\t\tfor(L.elem[max]){\n\t\t\tif(L.elem[i]==e)\n\t\t\t\treturn (i+1);\n\t\t\ti++;\n\t}\n\treturn 0;\n\t}\n```\nASL=P(\u88ab\u5bfb\u627e\u6240\u9700\u6b21\u6570)*C\uff08\u88ab\u627e\u5230\u6982\u7387\uff09\u7684n\u9879\u6c42\u548c\n5.\u63d2\u5165\uff1a\n```\n\tStatus inputlist(list &L,int i,int e){\n\t\tIf(i<1||i>L.length+1)\n\t\t\tReturn 0;\n\t\tIf(L.length==max)\n\t\t\t\tReurn 0;\n\t\tFor(int t=L.length-1;t>=i-1;t--){\n\t\t\t\tL.elem[t]=L.elem[t+1];\n\t\t}\n\t\tL.elem[i-1]=e;\t\n\t\tL.length++;\n\t\tReturn OK; \n\t}\n```\n6.\u5220\u9664\uff1a\n```\n\tInt delrteelem(list&L,int i,int &e){\n\t\tIf(i<1||i>L.length)\n\t\t\tReturn 0;\n\t\te=L.elem[i-1];\n\t\tFor(int t=i;t<L.length;t++)\n\t\t\tL.elem[t-1]=L.elem[t];\n\t\tL.length--;\n\t\tReturn e;\t}\n```\n\u5c0f\u603b\u7ed3:\n\t\u5bf9\u4e8efor\u5faa\u73af\u7684\u4e66\u5199\u9700\u6ce8\u610f\uff08\u6761\u4ef6\uff09\uff0c\u6570\u7ec4\u4e0b\u6807\u4e0e\u4e2a\u6570\u4e4b\u95f4\u7684\u8f6c\u5316\uff0c\u5bf9\u4e8e\u8f93\u5165\u7684\u8fb9\u754c\u5ba1\u67e5\uff0c\u4ee3\u7801\u7684\u683c\u5f0f\u7ec6\u8282\u3002", "top": 0, "createdAt": 1792308788, "style": "", "script": "", "head": "", "ogImage": "https://k.sinaimg.cn/n/spider20191226/384/w640h544/20191226/54ab-imfiehq2615626.jpg/w700d1q75cms.jpg", "createdDate": "2026-10-18", "dateLabelColor": "#1f883d"}, "P3": {"htmlDir": "docs/post/shu-ru.html", "labels": ["documentation"], "postTitle": "\u8f93\u5165", "postUrl": "post/shu-ru.html", "postSourceUrl": "https://github.com/laotie-hard/laotie-hard.github.io/issues/3", "commentNum": 0, "wordCount": 632, "description": "\u4e00\u884c\u82e5\u5e72\u6570\uff1a\n```\nint x;\nwhile(cin >> x){\n}\n```\nn\u884c\u82e5\u5e72\u6570\uff1a\n```\nint n;\nwhile(cin >> n){ \n    for(int i=0;i<n;i++){\n        cin >> arr[i];\n    }\n}\n```\n\u82e5\u5e72\u884c\u82e5\u5e72\u6570\uff1a\n```\n#include \\<iostream\\>\n#include \\<string\\>\n#include \\<sstream\\>\n#include \\<vector\\>\nusing namespace std;\n\nint main(){\n    string line;\n    while(getline(cin, line)){\n        stringstream ss(line);\n        vector<int> v; \n        int num;\n        while(ss >> num){\n            v.push_back(num);\n        }\n        for(int i = 0; i < v.size(); i++){\n            if(i != 0) cout << ' ';    //\u8f93\u5165\u7a7a\u683c\uff08\u672b\u5c3e\u65e0\u7a7a\u683c\uff09\n            cout << v[i];\n        }\n        cout << endl;\n    }\n    return 0;\n}\n```\u300