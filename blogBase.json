", "ogImage": "https://k.sinaimg.cn/n/spider20191226/384/w640h544/20191226/54ab-imfiehq2615626.jpg/w700d1q75cms.jpg", "createdDate": "2026-11-02", "dateLabelColor": "#1f883d"}, "P7": {"htmlDir": "docs/post/reflection.html", "labels": ["documentation"], "postTitle": "reflection", "postUrl": "post/reflection.html", "postSourceUrl": "https://github.com/laotie-hard/laotie-hard.github.io/issues/7", "commentNum": 0, "wordCount": 1588, "description": "quesion1:\n\u5929\u68af\u56fe\u4e66\u9605\u89c8\u5ba4\u8bf7\u4f60\u7f16\u5199\u4e00\u4e2a\u7b80\u5355\u7684\u56fe\u4e66\u501f\u9605\u7edf\u8ba1\u7a0b\u5e8f\u3002", "top": 0, "createdAt": 1793892258, "style": "", "script": "", "head": "", "ogImage": "https://k.sinaimg.cn/n/spider20191226/384/w640h544/20191226/54ab-imfiehq2615626.jpg/w700d1q75cms.jpg", "createdDate": "2026-11-05", "dateLabelColor": "#1f883d"}}, "singeListJson": {}, "labelColorDict": {"accessibility": "#f143ab", "bug": "#d73a4a", "documentation": "#0075ca", "duplicate": "#cfd3d7", "enhancement": "#a2eeef", "good first issue": "#7057ff", "help wanted": "#008672", "invalid": "#e4e669", "question": "#d876e3", "wontfix": "#ffffff"}, "displayTitle": "\u70d9\u94c1\u7684\u535a\u5ba2", "faviconUrl": "https://k.sinaimg.cn/n/spider20191226/384/w640h544/20191226/54ab-imfiehq2615626.jpg/w700d1q75cms.jpg", "ogImage": "https://k.sinaimg.cn/n/spider20191226/384/w640h544/20191226/54ab-imfiehq2615626.jpg/w700d1q75cms.jpg", "primerCSS": "<link href='https://mirrors.sustech.edu.cn/cdnjs/ajax/libs/Primer/21.0.7/primer.css' rel='stylesheet' />", "homeUrl": "https://laotie-hard.github.io", "prevUrl": "disabled", "nextUrl": "disabled"}